{
  "name": "fluxer",
  "module": "build-css.js",
  "type": "module",
  "private": true,
  "scripts": {
    "css": "bun run build-css.js",
    "css:watch": "bun run build-css.js --watch",
    "templates": "whiskers fluxer.tera",
    "templates:watch": "chokidar src/out.css -c \"whiskers fluxer.tera\"",
    "dev": "concurrently \"bun run css:watch\" \"bun run templates:watch\"",
    "build": "bun run css && bun run templates"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "cssnano": "^7.1.2",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1"
  }
}
